<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:endColor="#FF0E0E11"
                android:startColor="#FF18181C"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:height="3dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="#FFFF8C38"
                android:startColor="#FFE85D04"
                android:type="linear" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
