# Copy to secrets.properties (do not commit secrets.properties).
# Point the client at your own PROTO-compatible API. Backend is not included in this repo.

API_ORIGIN=https://your-server.example
WS_ORIGIN=wss://your-server.example/ws

# Optional WebRTC TURN (leave blank to use public STUN/TURN fallbacks only)
TURN_HOST=
TURN_USER=
TURN_CRED=
